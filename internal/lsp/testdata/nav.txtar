package p

open class /*|box*/Box<T>(val item: T) {
    open fun get(): T = item
}

class IntBox(i: Int) : Box<Int>(i) {
    override fun get() = 2
}

fun use(b: Box<String>?): String {
    var /*|y*/y = 1
    y += 2
    if (/*|b*/b != null) println(b./*|item*/item + y)
    return "" + IntBox(3)./*|get*/get() + /*|lib*/listOf(y)
}
