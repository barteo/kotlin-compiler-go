private fun g(a: Int, b: Int) = a

fun f(s: String): Int {
    println(s/*|safe*/?.length)
    /*|var*/var n = 1
    return g(n, 2) + (s /*|cast*/as String).length
}

class C {
    private fun /*|unused*/unused() = s!!
    private val s = "s"
}
