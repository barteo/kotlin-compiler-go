-- kc-lsp.json --
{"modules": [{"name": "main", "sourceRoots": ["src"]}]}
-- src/A.kt --
fun a(): Int = extra() + more()
-- _E.kt --
fun extra(): Int = 1
-- _M.kt --
fun more(): Int = 2
-- _config --
{"modules": [{"name": "main", "sourceRoots": ["src", "gen"]}]}
-- script --
# The client doesn't watch files: a file the module doesn't list is
# listed when it is opened, saved or closed, the others by the scan.
initialize
open src/A.kt
wait
diagnostics src/A.kt
write src/E.kt _E.kt
notify textDocument/didSave {"textDocument":{"uri":"ROOT/src/E.kt"}}
wait
diagnostics src/A.kt
write src/M.kt _M.kt
scan
wait
diagnostics src/A.kt
write src/M.kt -
scan
wait
diagnostics src/A.kt
# kc.reimport reloads the project.
write kc-lsp.json _config
write gen/M.kt _M.kt
request workspace/executeCommand {"command":"kc.reimport"}
wait
diagnostics src/A.kt
request workspace/executeCommand {"command":"kc.nothing"}
