-- src/shapes/Shape.kt --
package shapes

/** A shape; see [area]. */
abstract class /*|shape*/Shape(val /*|name*/name: String) {
    /** The area, in units. */
    abstract fun /*|area*/area(): Double
}

class Square(val side: Double) : Shape("square") {
    override fun area() = side * side
}

fun /*|make*/makeSquare(/*|side*/side: Double = 1.0) = Square(side)
-- src/app/Main.kt --
package app

import shapes.Shape
import shapes.makeSquare

class Circle(val r: Double) : Shape(name = "circle") {
    override fun area() = 3.14 * r * r
}

fun total(shapes: List<Shape>): Double {
    var /*|sum*/sum = 0.0
    for (s in shapes) sum += s./*|call*/area()
    return sum
}

fun main() {
    val all = listOf(makeSquare(side = 2.0), Circle(1.0))
    println(total(all) + all.size + all[0].name.length)
    loop@ for (x in all) { if (x.area() > 3) break@loop }
    /*|lib*/println("done")
}
