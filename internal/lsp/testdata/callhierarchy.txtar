-- src/shapes/Shape.kt --
package shapes

abstract class Shape {
    abstract fun /*|area*/area(): Double
    operator fun /*|plus*/plus(o: Shape): Double = area() + o.area()
}

class /*|square*/Square(val side: Double) : Shape() {
    init { /*|check*/check(side) }
    override fun area() = side * side
}

fun /*|check*/check(x: Double) = require(x >= 0)
-- src/app/Main.kt --
package app

import shapes.Square

val unit = Square(1.0)

fun /*|total*/total(xs: List<Square>): Double {
    var sum = 0.0
    xs.forEach { sum += it.area() }
    return sum + (unit + Square(2.0))
}
