package lib

class Box(val x: Int)
interface Shape {
    val area: Double
    fun scale(by: Double): Shape
}
-- src/app/Main.kt --
package app

import lib.Box

/*|square*/class Square : lib.Shape

fun f(s: String?, b: Box): Int {
    b./*|x*/x = 2
    return s./*|len*/length + /*|abs*/abs(-1)
}
