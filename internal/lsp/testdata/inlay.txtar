-- kc-lsp.json --
{"modules": [{"name": "main", "sourceRoots": ["src"]}]}
-- src/A.kt --
package p

enum class Color { RED }

class Box<T>(val item: T) {
    fun twice(f: (T) -> Int) = f(item) * 2
}

fun use(xs: List<Int>) {
    val b = Box("s")
    var n = b.twice { s -> s.length } + xs.size
    n += maxOf(1, 2) + Color.RED.ordinal
}
-- script --
initialize
open src/A.kt
wait
tokens src/A.kt
inlay src/A.kt
change src/A.kt 0:0 0:0 "// a comment\n"
inlay src/A.kt
