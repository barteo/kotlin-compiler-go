# A.kt is in no module once the project changes: only syntax errors.
write kc-lsp.json _config
notify workspace/didChangeWatchedFiles {"changes":[{"uri":"ROOT/kc-lsp.json","type":2}]}
wait
diagnostics src/A.kt
