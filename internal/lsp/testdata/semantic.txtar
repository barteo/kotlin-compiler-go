-- kc-lsp.json --
{"modules": [{"name": "main", "sourceRoots": ["src"]}]}
-- src/a/A.kt --
package a

fun main() {
    val n: Int = /*|bad*/"one"/*|badEnd*/
    println(n + helper())
    /*|nope*/nope()
}
-- src/a/B.kt --
package a

fun /*|name*/helper/*|nameEnd*/(): Int = 1
-- src/a/C.kt --
package a

val c: String = 1
-- src/b/D.kt --
package b

fun d(p: Pair<Int, Int>) {
    val [x, y] = p
}
-- script --
initialize
open src/a/A.kt
wait
diagnostics src/a/A.kt
# A file that isn't open shows its diagnostics too.
diagnostics src/a/C.kt
# An edit moves the diagnostics after it at once, and drops those it
# touches; the update then shows the new version's.
change src/a/A.kt @bad @badEnd "1"
diagnostics src/a/A.kt
wait
diagnostics src/a/A.kt
# An edit in one file changes another's diagnostics.
open src/a/B.kt
change src/a/B.kt @name @nameEnd "helper2"
wait
diagnostics src/a/A.kt
diagnostics src/a/B.kt
change src/a/B.kt 2:4 2:11 "helper"
wait
diagnostics src/a/A.kt
# An unsupported construct is information.
open src/b/D.kt
wait
diagnostics src/b/D.kt
shutdown
exit
