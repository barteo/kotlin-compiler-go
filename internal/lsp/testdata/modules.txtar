-- lib/src/Lib.kt --
package lib

class /*|counter*/Counter(start: Int) {
    var /*|value*/value = start
    fun /*|inc*/inc(by: Int = 1): Int {
        value += by
        return value
    }
}

fun /*|make*/makeCounter() = Counter(0)

val broken: Int = "not an int"
-- app/src/App.kt --
package app

import lib.Counter
import lib.makeCounter

fun main() {
    val c: Counter = /*|call*/makeCounter()
    c./*|use*/inc()
    c.inc(by = 2)
    println(c./*|v*/value)
    val wrong: String = c.value
}
-- lib2.kt --
package lib

class Counter(start: Int) {
    var value = start
    fun increment(by: Int = 1): Int = by
}

fun makeCounter(): Int = 0
