-- A.kt --
package demo

typealias Handler = (String) -> Unit

const val LIMIT = 10
val greeting: String = "hi"

interface Shape {
    fun area(): Double
}

data class Circle(val radius: Double, private var name: String, scale: Int) : Shape {
    override fun area(): Double {
        val local = radius * radius
        fun helper() = local
        return helper() * Math.PI
    }

    constructor(r: Int) : this(r.toDouble(), "c", 1)

    companion object {
        fun unit() = Circle(1.0, "unit", 1)
    }
}

enum class Color(val rgb: Int) {
    RED(0xff0000), GREEN(0x00ff00);

    fun hex() = rgb.toString(16)
}

object Registry {
    val shapes = mutableListOf<Shape>()
}

fun <T : Shape> T.describe(prefix: String = ""): String = prefix + area()
