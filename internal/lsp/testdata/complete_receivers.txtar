-- src/Model.kt --
package model

enum class Color { RED, GREEN, BLUE; fun dim() = this }

sealed interface Shape {
    val area: Double
}
data class Circle(val radius: Double) : Shape {
    override val area: Double get() = 3.14 * radius * radius
}
data class Square(val side: Double) : Shape {
    override val area: Double get() = side * side
    fun diagonal(): Double = side * 1.41
}

object Registry {
    val shapes = mutableListOf<Shape>()
    fun register(s: Shape) { shapes += s }
    const val LIMIT = 10
}

class Builder {
    var width = 0
    var height = 0
    fun size(w: Int, h: Int) { width = w; height = h }
    class Part(val name: String)
    inner class Slot
    companion object Factory {
        fun create(): Builder = Builder()
    }
}

fun build(block: Builder.() -> Unit): Builder = Builder().apply(block)

val Shape.label: String get() = "shape of $area"
fun Shape.describe(): String = label

fun <T : Comparable<T>> List<T>.largest(): T? = maxOrNull()
