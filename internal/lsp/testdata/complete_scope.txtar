package p

/** A box of [T]. */
open class Box<T>(val item: T) {
    /** Takes the item. */
    fun take(): T = item
    fun put(x: T, times: Int = 1) {}
    companion object {
        fun empty(): Box<String> = Box("")
    }
}

fun topLevel(n: Int): String = n.toString()

@Deprecated("old")
fun topOld(): Int = 1
