package p

class Point(val x: Int, val y: Int) {
    fun scaled(k: Int) = Point(x * k, y * k)
}

fun work(p: Point, names: List<String>) {
    val sum = p.x + p.y
    println(sum)
    if (sum > 0) {
        println(names.size)
    }
}
