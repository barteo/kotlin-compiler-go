From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kc <barteo@gmail.com>
Date: Thu, 5 Nov 2026 15:43:32 +0000
Subject: [PATCH 4/6] Find source file facades through KcExtras

KtFile.findFacadeClass needs light classes, which a backend other than
FIR's may not have.
---
 .../kotlin/com/google/devtools/ksp/impl/ResolverAAImpl.kt | 5 +----
 .../com/google/devtools/ksp/impl/backend/KcExtras.kt      | 8 ++++++++
 .../com/google/devtools/ksp/impl/backend/fir/FirExtras.kt | 7 +++++++
 3 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/ResolverAAImpl.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/ResolverAAImpl.kt
index 2d6a702..426e900 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/ResolverAAImpl.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/ResolverAAImpl.kt
@@ -128,8 +128,6 @@ import org.jetbrains.kotlin.analysis.api.symbols.KaSymbol
 import org.jetbrains.kotlin.analysis.api.symbols.KaTypeAliasSymbol
 import org.jetbrains.kotlin.analysis.api.types.KaType
 import org.jetbrains.kotlin.analysis.api.types.symbol
-import org.jetbrains.kotlin.asJava.classes.KtLightClassForFacade
-import org.jetbrains.kotlin.asJava.findFacadeClass
 import org.jetbrains.kotlin.builtins.jvm.JavaToKotlinClassMap
 import org.jetbrains.kotlin.cli.jvm.compiler.KotlinCliJavaFileManagerImpl
 import org.jetbrains.kotlin.load.java.JvmAbi
@@ -619,8 +617,7 @@ class ResolverAAImpl(
         } ?: declaration.containingFile?.let {
             // Find containing file facade class name from file symbol
             (it as? KSFileImpl)?.let {
-                ((it.ktFileSymbol.psi as? KtFile)?.findFacadeClass() as? KtLightClassForFacade)
-                    ?.facadeClassFqName?.asString()
+                (it.ktFileSymbol.psi as? KtFile)?.let { f -> KcExtras.instance.fileFacadeClass(f) }?.asString()
             }
             // Light facade classes for libraries are not available in AA; KcExtras finds the facade.
         } ?: ((declaration as? AbstractKSDeclarationImpl)?.ktDeclarationSymbol as? KaCallableSymbol)
diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KcExtras.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KcExtras.kt
index 0415997..e4ec05c 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KcExtras.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KcExtras.kt
@@ -28,6 +28,8 @@ import org.jetbrains.kotlin.load.java.structure.JavaAnnotationArgument
 import org.jetbrains.kotlin.load.kotlin.KotlinJvmBinaryClass
 import org.jetbrains.kotlin.load.kotlin.TypeMappingMode
 import org.jetbrains.kotlin.name.ClassId
+import org.jetbrains.kotlin.name.FqName
+import org.jetbrains.kotlin.psi.KtFile
 
 /**
  * The facts KSP needs that the public Analysis API doesn't offer.
@@ -58,6 +60,12 @@ interface KcExtras {
      */
     fun packagePartClass(symbol: KaCallableSymbol): ClassId?
 
+    /**
+     * The facade class of a source file's top-level callables: the
+     * `facadeClassFqName` of its `KtLightClassForFacade`, else null.
+     */
+    fun fileFacadeClass(file: KtFile): FqName?
+
     /**
      * The class a library property is compiled into: the class id of its
      * `containerSource`, a `JvmPackagePartSource` or a
diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/fir/FirExtras.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/fir/FirExtras.kt
