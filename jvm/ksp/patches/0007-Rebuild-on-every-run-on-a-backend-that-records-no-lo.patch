From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kc <barteo@gmail.com>
Date: Fri, 6 Nov 2026 22:14:05 +0000
Subject: [PATCH 7/7] Rebuild on every run on a backend that records no lookups

A backend whose beginRound tracker gets no front-end lookups sets
KspBackendSession.recordsLookups to false. An incremental run then
deletes caches.uptodate before and after processing: it rebuilds,
processing all files, and the next run, on any backend, rebuilds too
instead of trusting caches that miss the Kotlin sources' dependencies.
KSP's own lookups for Java sources are still recorded.
---
 .../devtools/ksp/common/IncrementalContextBase.kt   |  7 ++++++-
 .../devtools/ksp/impl/KotlinSymbolProcessing.kt     | 13 +++++++++++++
 .../google/devtools/ksp/impl/backend/KspBackend.kt  |  8 ++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
index 43f7c92..756042d 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
@@ -82,9 +82,14 @@ abstract class IncrementalContextBase(
     // Symbols defined in each file. This is saved across processing.
     protected val symbolsMap = FileToSymbolsMap(File(cachesDir, "symbols"))
 
-    private val cachesUpToDateFile = File(cachesDir, "caches.uptodate")
+    private val cachesUpToDateFile = File(cachesDir, CACHES_UP_TO_DATE)
     private val rebuild = !cachesUpToDateFile.exists()
 
+    companion object {
+        /** The marker of caches a later incremental run may trust; without it, the run rebuilds. */
+        const val CACHES_UP_TO_DATE = "caches.uptodate"
+    }
+
     private val logsDir = File(cachesDir, "logs").apply { mkdirs() }
     private val buildTime = Date().time
 
diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
index f419776..789cb45 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
@@ -18,6 +18,7 @@
 package com.google.devtools.ksp.impl
 
 import com.google.devtools.ksp.common.AnyChanges
+import com.google.devtools.ksp.common.IncrementalContextBase
 import com.google.devtools.ksp.common.KSObjectCacheManager
 import com.google.devtools.ksp.common.impl.AAResolutionStrategy
 import com.google.devtools.ksp.common.impl.CodeGeneratorImpl
@@ -92,8 +93,18 @@ class KotlinSymbolProcessing(
 
         val projectDisposable: Disposable = Disposer.newDisposable("StandaloneAnalysisAPISession.project")
         var session: KspBackendSession? = null
+        val cachesUpToDate = File(kspConfig.cachesDir, IncrementalContextBase.CACHES_UP_TO_DATE)
+        var rebuildEveryRun = false
         try {
             session = backend.open(kspConfig, projectDisposable)
+            if (kspConfig.incremental && !session.recordsLookups) {
+                // Without the front end's lookups the caches miss the Kotlin sources' dependencies:
+                // rebuild, processing all files, and leave the caches marked stale (below) so that
+                // the next run rebuilds too. KSP's own lookups (Java sources) are still recorded.
+                rebuildEveryRun = true
+                cachesUpToDate.delete()
+                logger.info("the ${backend.name} backend records no lookups; processing all files")
+            }
             KcExtras.instance = session.extras
             val project = session.project
             // Initializes it
@@ -233,6 +244,8 @@ class KotlinSymbolProcessing(
             dropCaches()
             codeGenerator.closeFiles()
         } finally {
+            if (rebuildEveryRun)
+                cachesUpToDate.delete()
             maybeRunInWriteAction {
                 session?.close()
                 Disposer.dispose(projectDisposable)
diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KspBackend.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KspBackend.kt
index 2c798c4..83fae74 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KspBackend.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/backend/KspBackend.kt
@@ -80,6 +80,14 @@ interface KspBackendSession {
     /** Called before each round, with the tracker the round records lookups in. */
     fun beginRound(lookupTracker: DualLookupTracker)
 
+    /**
+     * Whether the tracker [beginRound] gets receives the front end's lookups.
+     * When it doesn't, an incremental run rebuilds, processing all files, and
+     * leaves the caches marked stale, since they miss the dependencies of
+     * Kotlin sources.
+     */
+    val recordsLookups: Boolean get() = true
+
     /** Invalidates analysis caches after a round generated files; called in a write action. */
     fun dropCaches()
 
