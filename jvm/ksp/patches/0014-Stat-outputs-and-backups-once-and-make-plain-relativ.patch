From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kc <kc@localhost>
Date: Mon, 9 Nov 2026 21:44:52 +0000
Subject: [PATCH] Stat outputs and backups once and make plain relative paths
 directly

Backing up a run's outputs and restoring the clean ones checked every
output and backup with File.isFile, length and lastModified on the copy
and length and lastModified on the original: five stat calls per file,
twice per output, each run. Each file's attributes are now read once.

Paths relative to the base and output directories went through
relativeTo and toRelativeString, which split both paths into components
and normalize them, for every source and output file. A path that is the
base, a separator and a plain relative path is now cut directly; any
other takes the old way.
---
 .../ksp/common/IncrementalContextBase.kt      | 49 ++++++++++++++++---
 .../devtools/ksp/impl/IncrementalContextAA.kt |  2 +-
 2 files changed, 42 insertions(+), 9 deletions(-)

diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
index f3e718a..0882477 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/common/IncrementalContextBase.kt
@@ -29,9 +29,31 @@ import com.intellij.psi.PsiJavaFile
 import com.intellij.psi.PsiPackage
 import com.intellij.util.containers.MultiMap
 import java.io.File
+import java.io.IOException
+import java.nio.file.Files
+import java.nio.file.attribute.BasicFileAttributes
 import java.util.Date
 import java.util.concurrent.ConcurrentHashMap
 
+/**
+ * [path] relative to [base], as `File(path).relativeTo(base).path` gives it,
+ * without splitting both into components, when [path] is [base], a
+ * separator and a plain relative path (no `.` or `..` segments, no empty
+ * ones); null otherwise, for the caller to take the slow way.
+ */
+internal fun relativeUnder(path: String, base: File): String? {
+    val b = base.path
+    val sep = File.separatorChar
+    if (b.isEmpty() || path.length <= b.length + 1 || !path.startsWith(b) || path[b.length] != sep) return null
+    val rest = path.substring(b.length + 1)
+    if (rest[0] == '.' || rest[rest.length - 1] == sep || rest.contains("$sep.") || rest.contains("$sep$sep")) return null
+    return rest
+}
+
+/** [file] relative to [base], as [relativeTo] gives it. */
+internal fun relativeFile(file: File, base: File): File =
+    relativeUnder(file.path, base)?.let(::File) ?: file.relativeTo(base)
+
 object SymbolCollector : KSDefaultVisitor<(LookupSymbolWrapper) -> Unit, Unit>() {
     override fun defaultHandler(node: KSNode, data: (LookupSymbolWrapper) -> Unit) = Unit
 
@@ -93,8 +115,8 @@ abstract class IncrementalContextBase(
     private val logsDir = File(cachesDir, "logs").apply { mkdirs() }
     private val buildTime = Date().time
 
-    private val modified = knownModified.map { it.relativeTo(baseDir) }.toSet()
-    private val removed = knownRemoved.map { it.relativeTo(baseDir) }.toSet()
+    private val modified = knownModified.map { relativeFile(it, baseDir) }.toSet()
+    private val removed = knownRemoved.map { relativeFile(it, baseDir) }.toSet()
 
     protected abstract val isIncremental: Boolean
 
@@ -108,7 +130,7 @@ abstract class IncrementalContextBase(
 
     private val onDemandImportsCache = ConcurrentHashMap<PsiJavaFile, List<String>>()
 
-    private fun String.toRelativeFile() = File(this).relativeTo(baseDir)
+    private fun String.toRelativeFile() = relativeFile(File(this), baseDir)
     private val KSFile.relativeFile
         get() = filePath.toRelativeFile()
 
@@ -332,7 +354,7 @@ abstract class IncrementalContextBase(
         val bakRoot = File(cachesDir, "backups")
 
         fun File.abs() = File(baseDir, path)
-        fun File.bak() = File(bakRoot, abs().toRelativeString(outRoot))
+        fun File.bak() = abs().let { File(bakRoot, relativeUnder(it.path, outRoot) ?: it.toRelativeString(outRoot)) }
 
         // Backing up outputs is necessary for two reasons:
         //
@@ -346,11 +368,22 @@ abstract class IncrementalContextBase(
         //    fail and the outputs will need to be restored.
 
         // A copy that is already there, with the same length and time (the
-        // copies keep the time), is not made again: in a daemon, most outputs
-        // are those of the run before, backed up and restored then.
+        // copies keep the time, to the millisecond), is not made again: in a
+        // daemon, most outputs are those of the run before, backed up and
+        // restored then. Each file's attributes are read once.
+        fun attributes(f: File): BasicFileAttributes? =
+            try {
+                Files.readAttributes(f.toPath(), BasicFileAttributes::class.java)
+            } catch (e: IOException) {
+                null
+            }
         fun copy(src: File, dst: File) {
-            if (dst.isFile && dst.length() == src.length() && dst.lastModified() == src.lastModified())
-                return
+            val d = attributes(dst)
+            if (d != null && d.isRegularFile) {
+                val s = attributes(src)
+                if (s != null && s.size() == d.size() && s.lastModifiedTime().toMillis() == d.lastModifiedTime().toMillis())
+                    return
+            }
             copyWithTimestamp(src, dst, true)
         }
 
diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/IncrementalContextAA.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/IncrementalContextAA.kt
index 46e456a..61dee0c 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/IncrementalContextAA.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/IncrementalContextAA.kt
@@ -355,5 +355,5 @@ class LookupStorageWrapperImpl(
 
 internal class RelativeFileToPathConverter(val baseDir: File) : FileToPathConverter {
     override fun toPath(file: File): String = file.path
-    override fun toFile(path: String): File = File(path).relativeTo(baseDir)
+    override fun toFile(path: String): File = com.google.devtools.ksp.common.relativeFile(File(path), baseDir)
 }
