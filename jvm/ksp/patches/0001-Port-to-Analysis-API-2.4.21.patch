From: kc <barteo@gmail.com>
Date: Thu, 5 Nov 2026 11:54:48 +0000
Subject: [PATCH 1/5] Port to Analysis API 2.4.21

- KaType.mapToJvmType() is hidden; use mapToJvmTypeDescriptor().
- KaAnnotationImpl lost its useSiteTarget parameter.
- getEffectiveVariance moved to org.jetbrains.kotlin.types.typeUtil.
- The IntelliJ core bundled in kotlin-compiler has no EDT.updateEdt();
  call it reflectively, falling back to the field it sets.
---
 .../devtools/ksp/impl/KotlinSymbolProcessing.kt    | 14 +++++++++++++-
 .../com/google/devtools/ksp/impl/ResolverAAImpl.kt |  2 +-
 .../kotlin/synthetic/KSSyntheticAnnotations.kt     |  1 -
 .../google/devtools/ksp/impl/symbol/kotlin/util.kt |  2 +-
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
index 25e974e..82c68e8 100644
--- a/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
+++ b/kotlin-analysis-api/src/main/kotlin/com/google/devtools/ksp/impl/KotlinSymbolProcessing.kt
@@ -708,7 +708,7 @@ fun TargetPlatform.getPlatformInfo(kspConfig: KSPConfig): List<PlatformInfo> =
 private fun <R> maybeRunInWriteAction(f: () -> R) {
     synchronized(EDT::class.java) {
         if (!EDT.isCurrentThreadEdt())
-            EDT.updateEdt()
+            updateEdt()
         if (ApplicationManager.getApplication() != null) {
             runWriteAction {
                 f()
@@ -719,6 +719,18 @@ private fun <R> maybeRunInWriteAction(f: () -> R) {
     }
 }
 
+// EDT.updateEdt() makes the current thread the EDT. It is internal, and the
+// IntelliJ core bundled in kotlin-compiler lacks it, so it is called
+// reflectively, falling back to setting the field it sets.
+private fun updateEdt() {
+    val edt = EDT::class.java
+    try {
+        edt.getDeclaredMethod("updateEdt").apply { isAccessible = true }.invoke(null)
+    } catch (_: NoSuchMethodException) {
+        edt.getDeclaredField("myEventDispatchThread").apply { isAccessible = true }.set(null, Thread.currentThread())
+    }
+}
