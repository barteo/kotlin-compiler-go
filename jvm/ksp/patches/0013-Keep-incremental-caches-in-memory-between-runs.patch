+/**
+ * What a file looked like when it was last read or written here: a later
+ * read trusts the copy in memory only while the file still has the same
+ * size, modification time (in nanoseconds where the file system keeps
+ * them) and identity. A file that is missing has no stamp.
+ */
+internal data class FileStamp(val size: Long, val modified: Long, val key: Any?) {
+    companion object {
+        fun of(file: File): FileStamp? = try {
+            val a = Files.readAttributes(file.toPath(), BasicFileAttributes::class.java)
+            FileStamp(a.size(), a.lastModifiedTime().to(TimeUnit.NANOSECONDS), a.fileKey())
+        } catch (e: java.io.IOException) {
+            null
+        }
+    }
+}
+
 abstract class PersistentMap<K, V>(
     private val serializer: KSerializer<Map<K, V>>,
     private val storage: File,
     private val m: MutableMap<K, V>,
 ) : MutableMap<K, V> by m {
 
+    // A map that has not changed since it was read, or last written, is not
+    // written again: it is equal to the copy in memory, and its file still
+    // has the stamp that copy was taken with.
     @OptIn(ExperimentalSerializationApi::class)
     fun flush() {
+        val key = storage.absolutePath
+        val cached = loaded[key]
+        if (cached != null && cached.map == m && cached.stamp == FileStamp.of(storage))
+            return
+        loaded.remove(key)
         storage.outputStream().use {
             Json.encodeToStream(serializer, m.toMap(), it)
         }
+        FileStamp.of(storage)?.let { loaded[key] = Loaded(HashMap(m), it) }
     }
     override fun toString() = m.toString()
 
+    private class Loaded(val map: Map<*, *>, val stamp: FileStamp)
+
     companion object {
+        // The maps as last read or written in this process, by file. A
+        // daemon that runs KSP again on the same caches then reads a map
+        // from memory, not by decoding its file again. Each run gets its own
+        // copy; the values are lists that are replaced, never changed.
+        private val loaded = ConcurrentHashMap<String, Loaded>()
+
         @JvmStatic
         @OptIn(ExperimentalSerializationApi::class)
+        @Suppress("UNCHECKED_CAST")
         protected fun <K, V> deserialize(serializer: KSerializer<Map<K, V>>, storage: File): MutableMap<K, V> {
-            return if (storage.exists()) {
-                BufferedInputStream(storage.inputStream()).use {
-                    Json.decodeFromStream(serializer, it).toMutableMap()
-                }
-            } else {
-                mutableMapOf()
+            val key = storage.absolutePath
+            val stamp = FileStamp.of(storage)
+            if (stamp == null) {
+                loaded.remove(key)
+                return mutableMapOf()
+            }
+            loaded[key]?.let {
+                if (it.stamp == stamp)
+                    return HashMap(it.map as Map<K, V>)
+            }
+            val m = BufferedInputStream(storage.inputStream()).use {
+                Json.decodeFromStream(serializer, it).toMutableMap()
             }
+            loaded[key] = Loaded(HashMap(m), stamp)
+            return m
         }
     }
 }
