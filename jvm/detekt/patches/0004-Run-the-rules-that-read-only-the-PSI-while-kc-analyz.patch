 .../dev/detekt/core/tooling/Lifecycle.kt      |   9 +-
 3 files changed, 85 insertions(+), 37 deletions(-)

diff --git a/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt b/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
index db4a40f..94010f8 100644
--- a/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
+++ b/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
@@ -27,64 +27,102 @@ internal class Analyzer(
     private val processors: List<FileProcessListener>,
     private val analysisMode: AnalysisMode,
 ) {
+    /**
+     * The rules run in two waves: first those that read only the PSI, then
+     * those that read the Analysis API. kc analyzes the sources in the
+     * background, and the first rule to read its session waits for it; so
+     * the rules of the first wave run on every file while it analyzes. Each
+     * file's issues are in the order of its rules, as in one wave. With
+     * auto-correct, which changes the PSI, all the rules run in one wave.
+     */
+    private val waves: List<(RuleDescriptor) -> Boolean> =
+        if (settings.spec.rulesSpec.autoCorrect || System.getProperty("kc.waves") == "false") {
+            listOf { _ -> true }
+        } else {
+            listOf({ !it.requiresAnalysisApi }, { it.requiresAnalysisApi })
+        }
+
     fun run(ktFiles: Collection<KtFile>): List<Issue> {
         val languageVersionSettings = settings.languageVersionSettings
 
         return if (settings.spec.executionSpec.parallelAnalysis) {
-            runAsync(ktFiles, languageVersionSettings)
+            runAsync(ktFiles.toList(), languageVersionSettings)
         } else {
-            runSync(ktFiles, languageVersionSettings)
+            runSync(ktFiles.toList(), languageVersionSettings)
         }
     }
 
-    private fun runSync(ktFiles: Collection<KtFile>, languageVersionSettings: LanguageVersionSettings): List<Issue> =
-        ktFiles.flatMap { file ->
-            processors.forEach { it.onProcess(file) }
-            val issues = runCatching { analyze(file, languageVersionSettings) }.fold(
-                onSuccess = { it },
-                onFailure = { throwIllegalStateException(file, it) }
-            )
-            processors.forEach { it.onProcessComplete(file, issues) }
-            issues
+    private fun runSync(ktFiles: List<KtFile>, languageVersionSettings: LanguageVersionSettings): List<Issue> {
+        val results = waves.mapIndexed { wave, inWave ->
+            ktFiles.map { file ->
+                if (wave == 0) processors.forEach { it.onProcess(file) }
+                runCatching { analyze(file, languageVersionSettings, inWave) }.fold(
+                    onSuccess = { it },
+                    onFailure = { throwIllegalStateException(file, it) }
+                )
+            }
         }
+        return ktFiles.flatMapIndexed { i, file -> complete(file, results.map { it[i] }) }
+    }
 
-    private fun runAsync(ktFiles: Collection<KtFile>, languageVersionSettings: LanguageVersionSettings): List<Issue> {
+    private fun runAsync(ktFiles: List<KtFile>, languageVersionSettings: LanguageVersionSettings): List<Issue> {
         val service = settings.taskPool
-        val tasks: TaskList<List<Issue>?> = ktFiles.map { file ->
-            service.task {
-                processors.forEach { it.onProcess(file) }
-                val issues = analyze(file, languageVersionSettings)
-                processors.forEach { it.onProcessComplete(file, issues) }
-                issues
-            }.recover { throwIllegalStateException(file, it) }
+        // The pool takes the tasks in order: every file's first wave, then
+        // every file's second.
+        val tasks = waves.mapIndexed { wave, inWave ->
+            ktFiles.map { file ->
+                service.task {
+                    if (wave == 0) processors.forEach { it.onProcess(file) }
+                    analyze(file, languageVersionSettings, inWave)
+                }.recover { throwIllegalStateException(file, it) }
+            }
         }
-        return awaitAll(tasks).filterNotNull().flatten()
+        return ktFiles.flatMapIndexed { i, file -> complete(file, tasks.map { it[i].join().orEmpty() }) }
+    }
+
+    /** [file]'s issues from its waves' [results], in the order of its rules. */
+    private fun complete(file: KtFile, results: List<List<Pair<Int, List<Issue>>>>): List<Issue> {
+        val issues = results.flatten().sortedBy { it.first }.flatMap { it.second }
+        processors.forEach { it.onProcessComplete(file, issues) }
+        return issues
     }
 
-    private fun analyze(file: KtFile, languageVersionSettings: LanguageVersionSettings): List<Issue> {
+    /**
+     * The issues of the rules [inWave] takes on [file], each rule's with its
+     * place among the file's rules: the auto-correcting ones first.
+     */
+    private fun analyze(
+        file: KtFile,
+        languageVersionSettings: LanguageVersionSettings,
+        inWave: (RuleDescriptor) -> Boolean,
+    ): List<Pair<Int, List<Issue>>> {
         val (correctableRules, otherRules) = rules.asSequence()
-            .filter { ruleDescriptor ->
+            .withIndex()
+            .filter { (_, ruleDescriptor) -> inWave(ruleDescriptor) }
+            .filter { (_, ruleDescriptor) ->
                 ruleDescriptor.config.parent?.shouldAnalyzeFile(file, settings.spec.projectSpec.basePath) != false
             }
-            .filter { ruleDescriptor ->
+            .filter { (_, ruleDescriptor) ->
                 ruleDescriptor.config.shouldAnalyzeFile(file, settings.spec.projectSpec.basePath)
             }
-            .map { ruleDescriptor ->
-                ruleDescriptor.ruleInstance to ruleDescriptor.ruleProvider(ruleDescriptor.config)
+            .map { (index, ruleDescriptor) ->
+                Triple(index, ruleDescriptor.ruleInstance, ruleDescriptor.ruleProvider(ruleDescriptor.config))
             }
-            .filterNot { (ruleInstance, rule) ->
+            .filterNot { (_, ruleInstance, rule) ->
                 file.isSuppressedBy(ruleInstance.id, rule.aliases, ruleInstance.ruleSetId)
             }
-            .partition { (_, rule) -> rule.autoCorrect }
+            .partition { (_, _, rule) -> rule.autoCorrect }
 
-        return (correctableRules + otherRules).flatMap { (ruleInstance, rule) ->
-            rule.visitFile(file, languageVersionSettings)
-                .filterNot {
-                    it.entity.ktElement.isSuppressedBy(ruleInstance.id, rule.aliases, ruleInstance.ruleSetId)
-                }
-                .filterSuppressedFindings(rule, analysisMode)
-                .map { it.toIssue(ruleInstance, ruleInstance.severity, settings.spec.projectSpec.basePath) }
-        }
+        val ordered = correctableRules.map { it.first to it } + otherRules.map { rules.size + it.first to it }
+        return ordered.map { (order, r) ->
+                val (_, ruleInstance, rule) = r
+                order to rule.visitFile(file, languageVersionSettings)
+                    .filterNot {
+                        it.entity.ktElement.isSuppressedBy(ruleInstance.id, rule.aliases, ruleInstance.ruleSetId)
+                    }
+                    .filterSuppressedFindings(rule, analysisMode)
+                    .map { it.toIssue(ruleInstance, ruleInstance.severity, settings.spec.projectSpec.basePath) }
+            }
     }
 }
 
