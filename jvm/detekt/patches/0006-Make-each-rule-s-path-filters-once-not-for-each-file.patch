From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kc <kc@localhost>
Date: Wed, 18 Nov 2026 12:00:00 +0000
Subject: [PATCH] Make each rule's path filters once, not for each file

Analyzer checked each rule's includes and excludes, and its rule set's,
for each file by compiling their globs into new PathFilters: some
100,000 compilations on kotlinx-coroutines-core with --all-rules. The
filters of each config are made once now, and each file's relative path
once.

Co-authored-by: Claude <noreply@anthropic.com>
---
 .../main/kotlin/dev/detekt/core/Analyzer.kt   | 22 +++++++++++++++++--
 .../dev/detekt/core/util/ConfigExtensions.kt  |  9 +++++++-
 2 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt b/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
index 94010f8..5bfacbc 100644
--- a/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
+++ b/detekt-core/src/main/kotlin/dev/detekt/core/Analyzer.kt
@@ -14,7 +14,11 @@ import dev.detekt.api.internal.whichJava
 import dev.detekt.api.internal.whichOS
 import dev.detekt.core.suppressors.buildSuppressors
 import dev.detekt.core.suppressors.isSuppressedBy
+import dev.detekt.core.util.analyzedPath
+import dev.detekt.core.util.createPathFilters
 import dev.detekt.core.util.shouldAnalyzeFile
+import dev.detekt.utils.PathFilters
+import java.util.IdentityHashMap
 import dev.detekt.psi.absolutePath
 import dev.detekt.tooling.api.AnalysisMode
 import org.jetbrains.kotlin.config.LanguageVersionSettings
@@ -42,6 +46,19 @@ internal class Analyzer(
             listOf({ !it.requiresAnalysisApi }, { it.requiresAnalysisApi })
         }
 
+    /**
+     * The path filters of each rule's config and of its rule set's, made
+     * once: compiling their globs for each rule and file cost more than
+     * matching them.
+     */
+    private val pathFilters: Map<Config, PathFilters?> = IdentityHashMap<Config, PathFilters?>().also { m ->
+        for (r in rules) {
+            listOfNotNull(r.config, r.config.parent).forEach { c -> if (!m.containsKey(c)) m[c] = c.createPathFilters() }
+        }
+    }
+
+    private fun filters(c: Config): PathFilters? = if (pathFilters.containsKey(c)) pathFilters[c] else c.createPathFilters()
+
     fun run(ktFiles: Collection<KtFile>): List<Issue> {
         val languageVersionSettings = settings.languageVersionSettings
 
@@ -96,14 +113,15 @@ internal class Analyzer(
         languageVersionSettings: LanguageVersionSettings,
         inWave: (RuleDescriptor) -> Boolean,
     ): List<Pair<Int, List<Issue>>> {
+        val path = analyzedPath(file, settings.spec.projectSpec.basePath)
         val (correctableRules, otherRules) = rules.asSequence()
             .withIndex()
             .filter { (_, ruleDescriptor) -> inWave(ruleDescriptor) }
             .filter { (_, ruleDescriptor) ->
-                ruleDescriptor.config.parent?.shouldAnalyzeFile(file, settings.spec.projectSpec.basePath) != false
+                ruleDescriptor.config.parent?.let { shouldAnalyzeFile(filters(it), path) } != false
             }
             .filter { (_, ruleDescriptor) ->
-                ruleDescriptor.config.shouldAnalyzeFile(file, settings.spec.projectSpec.basePath)
+                shouldAnalyzeFile(filters(ruleDescriptor.config), path)
             }
             .map { (index, ruleDescriptor) ->
                 Triple(index, ruleDescriptor.ruleInstance, ruleDescriptor.ruleProvider(ruleDescriptor.config))
diff --git a/detekt-core/src/main/kotlin/dev/detekt/core/util/ConfigExtensions.kt b/detekt-core/src/main/kotlin/dev/detekt/core/util/ConfigExtensions.kt
index e5975cf..39795f8 100644
--- a/detekt-core/src/main/kotlin/dev/detekt/core/util/ConfigExtensions.kt
+++ b/detekt-core/src/main/kotlin/dev/detekt/core/util/ConfigExtensions.kt
@@ -15,7 +15,14 @@ internal fun Config.shouldAnalyzeFile(file: KtFile, basePath: Path): Boolean {
     return filters == null || !filters.isIgnored(file, basePath)
 }
 
-private fun Config.createPathFilters(): PathFilters? {
+/** [shouldAnalyzeFile] for the file at [relativePath] (see [analyzedPath]), with this config's [filters]. */
+internal fun shouldAnalyzeFile(filters: PathFilters?, relativePath: Path): Boolean =
+    filters == null || !filters.isIgnored(relativePath)
+
+/** The path of [ktFile] that a config's path filters match. */
+internal fun analyzedPath(ktFile: KtFile, basePath: Path): Path = Path(".", ktFile.absolutePath().relativeTo(basePath).toString())
+
+internal fun Config.createPathFilters(): PathFilters? {
     val includes = valueOrDefault(Config.INCLUDES_KEY, emptyList<String>())
     val excludes = valueOrDefault(Config.EXCLUDES_KEY, emptyList<String>())
     return PathFilters.of(includes, excludes)
