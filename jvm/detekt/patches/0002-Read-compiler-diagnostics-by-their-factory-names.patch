From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kc <kc@localhost>
Date: Tue, 17 Nov 2026 07:39:51 +0000
Subject: [PATCH] Read compiler diagnostics by their factory names

The rules that read a compiler diagnostic tell it by its class in the
FIR implementation of the Analysis API (KaFirDiagnostic), which kc's
Analysis API doesn't have. They tell it by its factory name instead,
which every implementation's diagnostics have: UNNECESSARY_SAFE_CALL
for KaFirDiagnostic.UnnecessarySafeCall, and so on. Deprecation takes
the diagnostic's default message for its message parameter.
---
 detekt-psi-utils/src/main/kotlin/dev/detekt/psi/TypeUtils.kt | 3 +--
 .../kotlin/dev/detekt/rules/potentialbugs/Deprecation.kt     | 5 ++---
 .../detekt/rules/potentialbugs/UnnecessaryNotNullOperator.kt | 3 +--
 .../dev/detekt/rules/potentialbugs/UnnecessarySafeCall.kt    | 3 +--
 .../kotlin/dev/detekt/rules/potentialbugs/UnreachableCode.kt | 3 +--
 .../main/kotlin/dev/detekt/rules/potentialbugs/UnsafeCast.kt | 3 +--
 6 files changed, 7 insertions(+), 13 deletions(-)

diff --git a/detekt-psi-utils/src/main/kotlin/dev/detekt/psi/TypeUtils.kt b/detekt-psi-utils/src/main/kotlin/dev/detekt/psi/TypeUtils.kt
index 17947a1..ae09fe0 100644
--- a/detekt-psi-utils/src/main/kotlin/dev/detekt/psi/TypeUtils.kt
+++ b/detekt-psi-utils/src/main/kotlin/dev/detekt/psi/TypeUtils.kt
@@ -3,7 +3,6 @@ package dev.detekt.psi
 import org.jetbrains.kotlin.analysis.api.KaExperimentalApi
 import org.jetbrains.kotlin.analysis.api.analyze
 import org.jetbrains.kotlin.analysis.api.components.KaDiagnosticCheckerFilter
-import org.jetbrains.kotlin.analysis.api.fir.diagnostics.KaFirDiagnostic
 import org.jetbrains.kotlin.psi.KtExpression
 import org.jetbrains.kotlin.psi.KtSafeQualifiedExpression
 
@@ -25,7 +24,7 @@ fun KtExpression.isNullable(shouldConsiderPlatformTypeAsNullable: Boolean): Bool
     if (this is KtSafeQualifiedExpression) {
         analyze(this) {
             return directDiagnostics(KaDiagnosticCheckerFilter.ONLY_COMMON_CHECKERS)
-                .none { it is KaFirDiagnostic.UnnecessarySafeCall }
+                .none { it.factoryName == "UNNECESSARY_SAFE_CALL" }
         }
     }
     analyze(this) {
